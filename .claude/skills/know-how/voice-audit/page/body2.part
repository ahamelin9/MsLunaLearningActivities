
<style>
.r1 { display: grid; gap: 12px }
.r1 table { border-collapse: collapse; width: 100%; font-size: 15px }
.r1 td, .r1 th { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--edge); vertical-align: top }
.r1 th { font-size: 12.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--quiet) }
.r1 td:first-child { white-space: nowrap; font-weight: 700 }
.pill { display: inline-block; font-size: 12.5px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--edge); background: var(--page); margin: 0 4px 4px 0 }
.pill.ok { border-color: var(--right); color: var(--right) }
.pill.no { border-color: var(--again); color: var(--again) }
.r1note { font-size: 13.5px; color: var(--quiet); font-style: italic }
.verdict ul { margin: 0; padding-left: 1.2em; display: grid; gap: 4px }
</style>
<div class="wrap">
  <header>
    <span class="eyebrow">Ms. Luna's Learning Pad · voice audit · round 2 · 28 October 2026</span>
    <h1>Luna's Sound Check</h1>
    <p class="lede">Round 2 is built from your round 1 notes. Every card starts with your round 1 pick (or today's clip), then the new takes. Press <b>Best</b> on the one that sounds like a teacher, or <b>None are right</b> with a note.</p>
  </header>

  <div class="verdict">
    <h2>What changed since round 1</h2>
    <ul>
      <li><b>F, TH, S, SH:</b> held from her real hiss. Round 1 held synthetic noise shaped like it, which is the "TV static" you heard.</li>
      <li><b>Long vowels:</b> said slowly by Luna instead of stretched afterwards (that was the robotic sound), and with nothing in front: no "h", no "k".</li>
      <li><b>Blends:</b> the second sound held with no "uh" ("bllll", "smmm"). Kokoro devoices it after K, P, T and F, so those blends join the first sound to a held L, R or W.</li>
      <li><b>Stops:</b> a slightly longer, softer release; /p/ quieter.</li>
      <li><b>Words:</b> the stray sound before or after a word is trimmed ("cup-ay", "a-sheep"), with slower versions to compare.</li>
    </ul>
  </div>

  <nav class="tabs" role="tablist" aria-label="What to listen to">
    <button class="tab" role="tab" data-tab="sounds" aria-selected="true">Letter sounds <span class="count" id="c-sounds"></span></button>
    <button class="tab" role="tab" data-tab="words" aria-selected="false">Names and words <span class="count" id="c-words"></span></button>
    <button class="tab" role="tab" data-tab="r1" aria-selected="false">Round 1 results</button>
    <button class="tab" role="tab" data-tab="plan" aria-selected="false">The plan</button>
    <span class="status" id="status" role="status">Loading the clips…</span>
  </nav>

  <section id="p-sounds" role="tabpanel"><div id="sounds"></div></section>
  <section id="p-words" role="tabpanel" hidden>
    <div class="group"><h3>Letter names you marked "both wrong"</h3><div id="names" class="group"></div></div>
    <div class="group"><h3>Words you marked "both wrong"</h3><p class="how">Plus "sheep" and "stops", which start with a stray sound.</p><div id="words" class="group"></div></div>
  </section>
  <section id="p-r1" role="tabpanel" hidden><div class="r1" id="r1"></div></section>
  <section id="p-plan" role="tabpanel" hidden><div class="plan" id="plan"></div></section>
</div>

<script>
const META = /*META*/null;
const R1_HTML = /*R1*/'';
const PLAN_HTML = /*PLAN*/'';
const PLAY = '<svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M5 3.5v13a1 1 0 0 0 1.5.86l11-6.5a1 1 0 0 0 0-1.72l-11-6.5A1 1 0 0 0 5 3.5z"/></svg>';
const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const SOUND_INFO = {
  ay: ['/ā/', 'A as in cake · AI · AY'], ee: ['/ē/', 'E as in tree · EE · EA'], eye: ['/ī/', 'I as in kite · IE · IGH'], oh: ['/ō/', 'O as in bone · OA · OW'],
  oo: ['/oo/', 'OO · UE, as in moon'], you: ['/ū/', 'U as in unicorn'], ar: ['/ar/', 'AR, as in star'], or: ['/or/', 'OR, as in fork'], er: ['/er/', 'ER · IR · UR, as in her'],
  b: ['/b/', 'B, as in bug'], d: ['/d/', 'D, as in duck'], g: ['/g/', 'G, as in gift'], p: ['/p/', 'P, as in pig'], t: ['/t/', 'T, as in tent'], k: ['/k/', 'C · K · CK, as in cat'],
  h: ['/h/', 'H, as in hat'], j: ['/j/', 'J · G as in giraffe'], w: ['/w/', 'W · WH, as in web'], y: ['/y/', 'Y, as in yarn'],
  m: ['/m/', 'M, as in moon'], n: ['/n/', 'N, as in nest'], l: ['/l/', 'L, as in leaf'], r: ['/r/', 'R, as in ring'],
  s: ['/s/', 'S · C as in city'], f: ['/f/', 'F, as in fox'], v: ['/v/', 'V, as in van'], z: ['/z/', 'Z, as in zebra'],
  sh: ['/sh/', 'SH, as in ship'], ch: ['/ch/', 'CH, as in chick'], th: ['/th/', 'TH, as in thumb'], dh: ['/th/ voiced', 'TH, as in this'],
  ng: ['/ng/', 'NG, as in ring'], kw: ['/kw/', 'Q · QU, as in queen']
};
const GROUPS = [
  ['Hisses', ['f', 'th', 's', 'sh', 'h']], ['Buzzes', ['v', 'z', 'dh']], ['Hums', ['m', 'n', 'ng', 'l', 'r']],
  ['Stops', ['b', 'd', 'g', 't', 'k', 'p']], ['J, CH, W, QU, Y', ['j', 'ch', 'w', 'kw', 'y']],
  ['Long vowels and R vowels', ['ay', 'ee', 'eye', 'oh', 'oo', 'you', 'ar', 'or', 'er']],
  ['Blends', ['bl', 'br', 'cl', 'cr', 'dr', 'fl', 'fr', 'gl', 'gr', 'pl', 'pr', 'tr', 'tw', 'sl', 'sm', 'sn', 'sw', 'sp', 'st', 'sk']]
];
const VOWELISH = new Set(['f', 'th', 's', 'sh', 'h', 'v', 'z', 'dh', 'ay', 'ee', 'eye', 'oh', 'oo', 'you', 'ar', 'or', 'er', 'r', 'l', 'm', 'n', 'ng', 'w', 'y']);
function machineNote(s, t) {
  if (VOWELISH.has(s) || s.length === 2 && 'bcdfgpt'.includes(s[0]) && 'lrw'.includes(s[1]) || ['sl', 'sm', 'sn', 'sw'].includes(s)) return '';
  const m = t.m; if (!m) return '';
  const heard = m.heard ? `heard as “${m.heard}”` : 'too short to name';
  const v = m.extraVowel >= 0.35 ? ` · <em>vowel after it ${Math.round(m.extraVowel * 100)}%</em>` : '';
  return `Machine ear: ${esc(heard)}${v}`;
}

let AUDIO = null;
const urls = new Map();
let current = null, currentBtn = null;
function clip(id) {
  if (!AUDIO || !AUDIO[id]) return null;
  if (!urls.has(id)) {
    const bin = atob(AUDIO[id]); const u8 = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i += 1) u8[i] = bin.charCodeAt(i);
    urls.set(id, URL.createObjectURL(new Blob([u8], { type: 'audio/mp4' })));
  }
  return urls.get(id);
}
function play(id, btn) {
  const url = clip(id); if (!url) return;
  if (current) { current.pause(); if (currentBtn) currentBtn.dataset.playing = 'false'; }
  current = new Audio(url); currentBtn = btn; btn.dataset.playing = 'true';
  const done = () => { btn.dataset.playing = 'false'; };
  current.onended = done; current.onerror = done; current.play().catch(done);
}
document.addEventListener('click', e => { const b = e.target.closest('[data-clip]'); if (b) play(b.dataset.clip, b); });

const picks = {};
let db = null, me = null, saveTo = 'device';
const LOCAL = 'luna-sound-check-r2';
try { Object.assign(picks, JSON.parse(localStorage.getItem(LOCAL) || '{}')); } catch {}
const safe = s => String(s).replace(/[^A-Za-z0-9_\-~:@+]/g, '_');
function setStatus() { document.getElementById('status').textContent = saveTo === 'claude' ? 'Your picks are saved for Claude' : 'Picks are saved on this device only'; }
const timers = {};
function save(item) {
  try { localStorage.setItem(LOCAL, JSON.stringify(picks)); } catch {}
  if (!db || !me) return;
  clearTimeout(timers[item]);
  timers[item] = setTimeout(() => {
    const p = picks[item] || {};
    db.doc(`picks/${safe(me)}--${safe(item)}`).set({ item, uid: me, choice: p.choice ?? null, note: p.note ?? '', at: new Date().toISOString() })
      .catch(() => { saveTo = 'device'; setStatus(); });
  }, 400);
}

function card({ item, title, sub, r1note, takes, prefix, id, sound }) {
  const list = takes.map(t => {
    const note = sound ? machineNote(sound, t) : '';
    return `<div class="take" data-take="${esc(t.take)}">
      <button class="play" data-clip="${prefix}:${esc(id)}:${esc(t.take)}" aria-label="Play ${esc(title)}, ${esc(t.label)}">${PLAY}</button>
      <span class="label">${esc(t.label)}${t.small ? `<small>${esc(t.small)}</small>` : ''}${note ? `<small class="machine">${note}</small>` : ''}</span>
      <button class="pick" data-item="${item}" data-choice="${esc(t.take)}">Best</button></div>`;
  }).join('');
  return `<article class="card" data-item="${item}">
    <div class="card-head"><span class="sym">${esc(title)}</span><span class="letters">${esc(sub)}</span></div>
    ${r1note ? `<p class="r1note">Your round 1 note: “${esc(r1note)}”</p>` : ''}
    <div class="takes">${list}</div>
    <div class="row"><button class="chip none" data-item="${item}" data-choice="none" aria-pressed="false">None are right</button></div>
    <textarea class="note" id="note-${esc(item)}" data-item="${item}" rows="1" placeholder="What's off? (optional)"></textarea>
  </article>`;
}
function build() {
  const bySound = Object.fromEntries(META.cards.map(c => [c.sound, c]));
  document.getElementById('sounds').innerHTML = GROUPS.map(([title, ids]) => `<div class="group"><h3>${esc(title)}</h3>${ids.filter(s => bySound[s]).map(s => {
    const c = bySound[s]; const info = SOUND_INFO[s] || [`/${s}/`, s.toUpperCase()];
    return card({ item: c.item, title: info[0], sub: info[1], r1note: c.note, takes: c.takes, prefix: 's2', id: s, sound: s });
  }).join('')}</div>`).join('');
  const NAME_TEXT = { CH: 'C H' };
  document.getElementById('names').innerHTML = META.nameCards.map(c => card({ item: c.item, title: NAME_TEXT[c.name] || c.name, sub: 'letter name', r1note: c.note, takes: c.takes, prefix: 'n2', id: c.name })).join('');
  document.getElementById('words').innerHTML = META.wordCards.map(c => card({ item: c.item, title: c.word, sub: 'word', r1note: c.note, takes: c.takes, prefix: 'w2', id: c.word })).join('');
  document.getElementById('r1').innerHTML = R1_HTML;
  document.getElementById('plan').innerHTML = PLAN_HTML;
  for (const [item, p] of Object.entries(picks)) paint(item, p);
  counts();
}
function paint(item, p) {
  const c = document.querySelector(`.card[data-item="${CSS.escape(item)}"]`); if (!c) return;
  c.querySelectorAll('.take').forEach(t => { t.dataset.picked = String(p.choice === t.dataset.take); });
  c.querySelectorAll('.chip').forEach(x => x.setAttribute('aria-pressed', String(p.choice === x.dataset.choice)));
  const note = c.querySelector('.note'); if (note && document.activeElement !== note) note.value = p.note || '';
  c.dataset.done = String(Boolean(p.choice));
}
function counts() {
  const n = pre => Object.entries(picks).filter(([k, p]) => pre.some(x => k.startsWith(x)) && p.choice).length;
  document.getElementById('c-sounds').textContent = `${n(['s2:'])}/${META.cards.length}`;
  document.getElementById('c-words').textContent = `${n(['n2:', 'w2:'])}/${META.nameCards.length + META.wordCards.length}`;
}
document.addEventListener('click', e => {
  const b = e.target.closest('[data-choice]'); if (!b) return;
  const item = b.dataset.item; const p = picks[item] || (picks[item] = {});
  p.choice = p.choice === b.dataset.choice ? null : b.dataset.choice;
  paint(item, p); counts(); save(item);
});
document.addEventListener('input', e => {
  const t = e.target.closest('.note'); if (!t) return;
  const item = t.dataset.item; const p = picks[item] || (picks[item] = {});
  p.note = t.value; save(item);
});
document.querySelectorAll('.tab').forEach(tab => tab.addEventListener('click', () => {
  document.querySelectorAll('.tab').forEach(t => t.setAttribute('aria-selected', String(t === tab)));
  document.querySelectorAll('[role="tabpanel"]').forEach(p => { p.hidden = p.id !== `p-${tab.dataset.tab}`; });
  try { localStorage.setItem(LOCAL + '-tab', tab.dataset.tab); } catch {}
}));
try { const t = localStorage.getItem(LOCAL + '-tab'); if (t) document.querySelector(`.tab[data-tab="${t}"]`)?.click(); } catch {}

build();
setStatus();
fetch('audio.json').then(r => r.json()).then(a => { AUDIO = a; setStatus(); }).catch(() => { document.getElementById('status').textContent = 'The clips didn\'t load. Reload the page.'; });
(async () => {
  try {
    db = await window.claude?.use?.('db');
    const user = await window.claude?.use?.('user');
    me = user ? await user.id() : null;
    if (!db || !me) return;
    const snap = await db.collection('picks').where('uid', '==', me).get();
    for (const d of snap.docs) {
      const v = d.data(); if (!v || !v.item) continue;
      picks[v.item] = { ...(picks[v.item] || {}), choice: v.choice ?? null, note: v.note ?? '' };
      paint(v.item, picks[v.item]);
    }
    counts(); saveTo = 'claude'; setStatus();
    for (const item of Object.keys(picks)) if (!snap.docs.some(d => d.data()?.item === item)) save(item);
  } catch { saveTo = 'device'; setStatus(); }
})();
</script>
