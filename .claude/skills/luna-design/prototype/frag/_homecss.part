.t-light { --sky: #EBDFCC; --dune1: #E0CFB6; --dune2: #D9C4A6; --dune3: #CDB592; --plume: #F4EAD9; --plume2: #E8D7BC; --plume-line: #D9C4A6; --reed: #A88B66; --pill: #FFFBF5; --pill-edge: #D9C4A6; --indicator: rgba(59, 42, 32, 0.45); --glass: rgba(255, 251, 245, 0.7); }
.t-dark { --sky: #261E1B; --dune1: #33281F; --dune2: #2C221B; --dune3: #201914; --plume: #8C7A64; --plume2: #7A6A56; --plume-line: #6B5A48; --reed: #5A4636; --pill: #2A211B; --pill-edge: #433629; --indicator: rgba(244, 234, 220, 0.5); --glass: rgba(42, 33, 27, 0.85); }
.sky { position: absolute; inset: 0; background: var(--sky); transition: background-color 400ms ease; }
.dune { position: absolute; border-radius: 50%; transition: background-color 400ms ease; animation: rise 1100ms cubic-bezier(0.34, 1.3, 0.64, 1) both; }
.sun { position: absolute; left: 820px; top: 96px; width: 150px; height: 150px; border-radius: 999px; background: #FFF8EC; animation: drift 10s ease-in-out infinite, halo 7s ease-in-out infinite; }
.moon { position: absolute; left: 800px; top: 70px; animation: drift 10s ease-in-out infinite; }
.moon-glow { animation: moonGlow 6s ease-in-out infinite; }
.star { position: absolute; width: 4px; height: 4px; border-radius: 999px; background: #FBEFD9; animation: twinkle 4.5s ease-in-out infinite; }
.fluff { position: absolute; width: 6px; height: 6px; border-radius: 999px; background: #FFFBF5; animation: float 14s linear infinite; }
.pampas { transform-box: fill-box; transform-origin: 50% 100%; animation: sway 7s ease-in-out infinite; }
.in { animation: enter 700ms cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.beckon { animation: beckon 5s ease-in-out 1.6s infinite; }
.dot { animation: wave 1.6s ease-in-out infinite; }
.app { background: none; border: none; padding: 0; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 12px; font-family: 'Andika', sans-serif; color: var(--ink); transition: transform 120ms cubic-bezier(0.2, 0, 0, 1); }
.app:active { transform: scale(0.92); }
.app:focus-visible { outline: 3px solid var(--focus); outline-offset: 8px; border-radius: 34px; }
.gear { cursor: pointer; border: none; transition: transform 120ms cubic-bezier(0.2, 0, 0, 1); }
.gear:active { transform: scale(0.92); }
.gear:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
@keyframes drift { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
@keyframes halo { 0%, 100% { box-shadow: 0 0 0 22px rgba(255, 251, 245, 0.35), 0 0 0 52px rgba(255, 251, 245, 0.16); } 50% { box-shadow: 0 0 0 30px rgba(255, 251, 245, 0.42), 0 0 0 66px rgba(255, 251, 245, 0.2); } }
@keyframes moonGlow { 0%, 100% { filter: drop-shadow(0 0 10px rgba(242, 207, 99, 0.35)); } 50% { filter: drop-shadow(0 0 22px rgba(242, 207, 99, 0.6)); } }
@keyframes twinkle { 0%, 100% { opacity: 0.25; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1.2); } }
@keyframes sway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(4deg); } }
@keyframes beckon { 0%, 80%, 100% { transform: scale(1) rotate(0deg); } 85% { transform: scale(1.07) rotate(-3deg); } 90% { transform: scale(1.03) rotate(3deg); } 95% { transform: scale(0.98); } }
@keyframes enter { 0% { transform: translateY(26px) scale(0.92); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
@keyframes rise { 0% { transform: translateY(60px); } 100% { transform: translateY(0); } }
@keyframes wave { 0%, 100% { opacity: 0.35; transform: scale(0.85); } 50% { opacity: 1; transform: scale(1); } }
@keyframes float { 0% { transform: translate(0, 0); opacity: 0; } 15% { opacity: 0.9; } 85% { opacity: 0.9; } 100% { transform: translate(180px, -120px); opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .sun, .moon, .moon-glow, .star, .fluff, .pampas, .dune, .in, .beckon, .dot { animation: none !important; } .fluff { display: none; } }
