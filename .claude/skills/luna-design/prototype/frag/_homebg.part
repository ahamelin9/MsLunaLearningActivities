  <div class="sky"></div>

  <!-- day: a pale sun and drifting fluff; night: a crescent moon and stars -->
  <sc-if value="{{ isLight }}" hint-placeholder-val="{{ true }}">
    <div class="sun"></div>
    <span class="fluff" style="left: 160px; top: 520px;"></span>
    <span class="fluff" style="left: 420px; top: 600px; animation-delay: -5s;"></span>
    <span class="fluff" style="left: 760px; top: 560px; width: 4px; height: 4px; animation-delay: -9s;"></span>
  </sc-if>
  <sc-if value="{{ isDark }}" hint-placeholder-val="{{ false }}">
    <span class="star" style="left: 90px; top: 90px;"></span>
    <span class="star" style="left: 230px; top: 180px; width: 3px; height: 3px; animation-delay: 1.1s;"></span>
    <span class="star" style="left: 380px; top: 70px; width: 5px; height: 5px; animation-delay: 2.3s;"></span>
    <span class="star" style="left: 520px; top: 150px; animation-delay: 0.6s;"></span>
    <span class="star" style="left: 640px; top: 60px; width: 3px; height: 3px; animation-delay: 3.1s;"></span>
    <span class="star" style="left: 700px; top: 230px; animation-delay: 1.8s;"></span>
    <span class="star" style="left: 1040px; top: 300px; width: 5px; height: 5px; animation-delay: 2.7s;"></span>
    <span class="star" style="left: 1110px; top: 120px; width: 3px; height: 3px; animation-delay: 0.3s;"></span>
    <span class="star" style="left: 960px; top: 400px; width: 3px; height: 3px; animation-delay: 3.6s;"></span>
    <span class="star" style="left: 150px; top: 330px; width: 3px; height: 3px; animation-delay: 2s;"></span>
    <span class="star" style="left: 300px; top: 420px; animation-delay: 4s;"></span>
    <svg class="moon" width="190" height="190" viewBox="0 0 200 200">
      <path class="moon-glow" d="M40 60.2 A72 72 0 1 0 160 60.2 A60 60 0 1 1 40 60.2 Z" transform="rotate(62 100 110)" fill="#F2CF63"></path>
      <circle cx="68" cy="152" r="5" fill="#F7DE8E" transform="rotate(62 100 110)"></circle>
      <circle cx="132" cy="150" r="7" fill="#F7DE8E" transform="rotate(62 100 110)"></circle>
    </svg>
  </sc-if>

  <div class="dune" style="left: -260px; bottom: -420px; width: 1100px; height: 700px; background: var(--dune1); animation-delay: 0ms;"></div>
  <div class="dune" style="left: 520px; bottom: -460px; width: 1100px; height: 700px; background: var(--dune2); animation-delay: 120ms;"></div>
  <div class="dune" style="left: -120px; bottom: -560px; width: 1400px; height: 760px; background: var(--dune3); animation-delay: 240ms;"></div>

  <svg class="pampas" style="position: absolute; left: 40px; bottom: 40px;" width="170" height="330" viewBox="0 0 170 330">
    <path d="M70 330 C66 240 60 170 40 70" style="fill: none; stroke: var(--reed); stroke-width: 4; stroke-linecap: round;"></path>
    <path d="M40 70 C20 40 26 10 36 0 C52 24 62 60 58 110 C48 100 44 86 40 70 Z" style="fill: var(--plume);"></path>
    <path d="M40 30 l-10 -6 M44 48 l-12 -4 M48 66 l-12 -2 M50 84 l-11 0 M44 40 l10 -6 M50 58 l10 -4 M54 76 l9 -2" style="stroke: var(--plume-line); stroke-width: 2; stroke-linecap: round;"></path>
    <path d="M80 330 C84 250 96 190 122 120" style="fill: none; stroke: var(--reed); stroke-width: 4; stroke-linecap: round;"></path>
    <path d="M122 120 C130 90 146 70 158 64 C158 96 146 132 124 160 C120 148 120 134 122 120 Z" style="fill: var(--plume2);"></path>
    <path d="M136 96 l8 -6 M130 112 l10 -4 M126 130 l10 -2 M132 104 l-8 -2 M126 122 l-8 0" style="stroke: var(--plume-line); stroke-width: 2; stroke-linecap: round;"></path>
  </svg>
  <svg class="pampas" style="position: absolute; right: 30px; bottom: 30px; animation-delay: -3s;" width="150" height="300" viewBox="0 0 150 300">
    <path d="M90 300 C92 220 100 150 118 60" style="fill: none; stroke: var(--reed); stroke-width: 4; stroke-linecap: round;"></path>
    <path d="M118 60 C128 34 124 10 116 0 C100 26 92 62 98 104 C108 92 114 78 118 60 Z" style="fill: var(--plume);"></path>
    <path d="M118 26 l9 -5 M114 44 l11 -3 M110 62 l11 -1 M112 36 l-9 -5 M106 54 l-10 -3 M102 74 l-9 -1" style="stroke: var(--plume-line); stroke-width: 2; stroke-linecap: round;"></path>
    <path d="M80 300 C74 230 58 180 30 130" style="fill: none; stroke: var(--reed); stroke-width: 4; stroke-linecap: round;"></path>
    <path d="M30 130 C16 112 8 92 8 80 C26 88 44 110 50 140 C42 140 36 136 30 130 Z" style="fill: var(--plume2);"></path>
  </svg>

